# Local API development (copy to .env — never commit .env)
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
CORS_ORIGINS=*
SEARCH_MODE=fts
ADMIN_TOKEN=

# Optional: vector search + ingest with embeddings
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# AZURE_OPENAI_API_VERSION=2024-02-01

# Mobile (Expo) — production URL from `modal deploy` output
# EXPO_PUBLIC_API_BASE_URL=https://your-workspace--gem-contractor-directory-api-api.modal.run
# EXPO_PUBLIC_CONTACT_FORM_URL=https://docs.google.com/forms/d/e/YOUR_FORM_ID/viewform
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://sites.google.com/view/your-page

# Scrape (Modal secret gem-contractor-directory-secrets — not used locally)
# GEM_COOKIE=GeM=...; TS01...

# Ingest on Modal: 0 = FTS-only rows (no Azure), 1 = require embeddings
INGEST_REQUIRE_EMBEDDINGS=0
